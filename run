#!/usr/bin/env bash
#
# Launch the pyDataOrg web GUI (secure mode: port + password).
#
# Usage:
#   ./run [PORT] [PASSWORD]
#
# Examples:
#   ./run 8800 secret        # port 8800, password "secret"
#   ./run 8800               # port 8800, prompts for password
#   ./run                    # default port, prompts for password
#
# Notes:
#   - Secure mode locks the file browser to the launch dir + your home, plus
#     any folders listed (os.pathsep-separated) in PYDATAORG_EXTRA_ROOTS, e.g.
#       PYDATAORG_EXTRA_ROOTS=/mnt/instrument:/data/shared ./run 8800
#   - Open the printed URL in a browser and enter the password.
#   - Stop with Ctrl-C.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$REPO_DIR"

# Make the local package importable without a pip install.
export PYTHONPATH="$REPO_DIR:${PYTHONPATH:-}"

exec python3 -c 'from pyDataOrg.web_app.app_cli import main_secure; main_secure()' "$@"
